# ==============================================================================
# OpenFOAM Simulation Artifacts
# ==============================================================================

# Parallel processor subdomains (e.g. processor0/, processor1/, etc.)
processor*

# Run log files generated by solvers & utilities
log.*
*.log

# Reconstructed / serial time-step solution directories
# Matches numerical directories (e.g. 50, 100, 200, 250)
[1-9]*
0.*

# Post-processing monitors (force coefficients, residuals, surface probes)
postProcessing/

# ParaView dummy files and temporary scene exports
*.foam
*.foam.*
*.OpenFOAM

# Generated polyMesh directories (reconstructed meshes belong in build artifacts)
constant/polyMesh/

# Generated feature edge meshes (generated from surfaceFeatureExtract)
constant/extendedFeatureEdgeMesh/
constant/triSurface/*.eMesh
system/surfaceFeatureExtractDict.eMesh

# Dynamic code compilation caches & function object shared objects
dynamicCode/
platforms/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Temporary, backup, and lock files
*~
*.swp
*.bak
*.orig
.directory
.DS_Store

# ==============================================================================
# Exceptions (Explicitly Tracked Essentials)
# ==============================================================================

# Ensure initial conditions are always tracked
!0/
!0.orig/
!0/**
!0.orig/**

# Ensure the source CAD/STL geometry is tracked
!constant/triSurface/blahaj.stl

# Ensure ParaView state, scripts, and renders are tracked
!ParaView/
!ParaView/**
!scripts/
!scripts/**
scripts/__pycache__/
